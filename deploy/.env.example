# Secrets for Hearth. Keep this file mode 600 and out of version control.
AUDIO_GID=29
HEARTH_DATA=./data
TZ=Europe/London

# Speech-to-text / summaries (only the ones you use)
LOCALAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPUSOS_TOKEN=

# MQTT login for the broker Home Assistant uses
HEARTH_MQTT_PASSWORD=

# API tokens, one per device: name:token,name:token   (openssl rand -hex 24)
HEARTH_API_TOKENS=

HEARTH_SMTP_PASSWORD=
HEARTH_WEBHOOK_SECRET=
